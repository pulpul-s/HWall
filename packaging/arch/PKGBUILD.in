# Generated by scripts/package-arch.sh from this template.
pkgname=hwall
pkgver=@VERSION@
pkgrel=@RELEASE@
pkgdesc='Linux hardware inventory and live sensor monitor'
arch=('@ARCH@')
license=('custom')
depends=(
  'glibc'
  'gcc-libs'
  'gtk4>=4.8'
)
optdepends=(
  'lm_sensors: configured sensor labels and improved hwmon interpretation'
  'hwdata: readable PCI vendor and device names'
  'ethtool: network driver and firmware information'
  'smartmontools: SMART health and lifetime data for supported drives'
  'nvme-cli: detailed NVMe health warnings and lifetime counters'
  'dmidecode: motherboard, firmware, CPU socket, and memory module inventory'
  'polkit: privileged SMART and NVMe retries through pkexec'
  'nvidia-utils: complete NVIDIA telemetry through nvidia-smi'
  'kconfig: KDE Plasma window-placement settings'
  'qt6-tools: KDE Plasma D-Bus integration through qdbus6'
)

# package-arch.sh builds and stages HWall before invoking makepkg. This recipe
# turns that staged filesystem into a native Arch package while preserving
# depends and optdepends metadata.
source=()
sha256sums=()

package() {
  install -d "$pkgdir"
  cp -a --no-preserve=ownership "$srcdir/../payload/." "$pkgdir/"
}
